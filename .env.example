# SaiRecon — API keys
# Copy this file to .env and fill in your keys.
# The install script fills this automatically (Step 6).
# sairecon loads this file automatically on every scan.

# GitHub personal access token — unlocks github-subdomains source
# Get it: github.com → Settings → Developer settings → Personal access tokens → Tokens (classic)
# Minimum scope: public_repo (read-only)
GITHUB_TOKEN=

# ProjectDiscovery Cloud Platform key — needed for asnmap (ASN/CIDR mapping)
# Get it: app.projectdiscovery.io → API keys  (free tier available)
PDCP_API_KEY=

# Shodan API key — used by uncover for passive asset search
# Get it: account.shodan.io → My Account  (free tier: 1 query/sec)
SHODAN_API_KEY=

# Censys API credentials — used by uncover
# Get them: search.censys.io → Account → API  (free tier: 250 queries/month)
CENSYS_API_ID=
CENSYS_API_SECRET=
